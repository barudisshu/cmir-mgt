<Configuration status="OFF" monitorInterval="1800">
  <Properties>
    <Property name="LOG_PATTERN"><![CDATA[$white{%d{yyyy-MM-dd HH:mm:ss}} %blue{[%32.32t]} %green{%-5level} %style{%c{1.}}{cyan} - %m%n%throwable]]></Property>
  </Properties>
  <Appenders>
    <Console name="STDOUT" target="SYSTEM_OUT" follow="true">
      <ThresholdFilter level="TRACE" onMatch="ACCEPT" onMismatch="DENY"/>
      <PatternLayout pattern="${LOG_PATTERN}" disableAnsi="false"/>
    </Console>
  </Appenders>
  <Loggers>
    <Logger name="cc.cmir" level="DEBUG" additivity="false">
      <AppenderRef ref="STDOUT"/>
    </Logger>

    <Root level="INFO">
      <AppenderRef ref="STDOUT"/>
    </Root>
  </Loggers>
</Configuration>
